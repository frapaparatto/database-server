#!/usr/bin/env bash
# Sends requests to the local server and appends each result to a log file.
# Usage: ./experiment [run-label]

set -u

BASE_URL="http://localhost:4000"
LOG_FILE="experiments.log"
RUN_LABEL="${1:-unlabeled}"

# run_experiment ID DESCRIPTION PATH
run_experiment() {
  local id="$1"
  local description="$2"
  local path="$3"
  local url="${BASE_URL}${path}"

  {
    echo "EXPERIMENT: ${id}"
    echo "run: ${RUN_LABEL}"
    echo "time: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "description: ${description}"
    echo "request: GET ${url}"
    echo "result:"
    curl -sS -i "$url" 2>&1 || echo "curl failed (is the server running?)"
    echo
    echo
  } >> "$LOG_FILE"

  echo "logged ${id}"
}

run_experiment "get-missing-key" "Get a key that was never set" "/get?key=missing"
run_experiment "get-no-param" "Get without the key parameter" "/get"
run_experiment "set-empty-value" "Set a key with an empty value" "/set?a="
run_experiment "set-partial-invalid" "Set one valid pair and one empty pair" "/set?a=1&b="
run_experiment "get-after-partial-set" "Get a key from the rejected multi-pair set" "/get?key=a"
run_experiment "update-a-value" "Set a key to be 2 instead of 1" "/set?a=2"
run_experiment "get-after-update" "Get a key from an update" "/get?key=a"
